{
  "name": "blink-node-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "gateway": "tsx realtime/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:init": "tsx scripts/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:load": "tsx tests/load.ts",
    "test:proxy": "tsx tests/proxy-integration.ts",
    "test:subscriptions": "tsx tests/subscriptions-integration.ts",
    "lint": "eslint .",
    "format": "prettier --write src realtime scripts tests *.ts *.mjs *.json",
    "format:check": "prettier --check src realtime scripts tests *.ts *.mjs *.json",
    "test:docker": "tsx tests/docker-smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "latest",
    "@tabler/icons-react": "latest",
    "@xterm/addon-fit": "latest",
    "@xterm/xterm": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "latest",
    "ipaddr.js": "latest",
    "next": "latest",
    "postgres": "latest",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "tsx": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "drizzle-kit": "^0.31.11",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
