FROM --platform=$BUILDPLATFORM rust:1.92-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/zig \
    && /opt/zig/bin/pip install --no-cache-dir --only-binary=:all: cargo-zigbuild==0.24.1 ziglang==0.14.1
ENV PATH="/opt/zig/bin:${PATH}"
RUN rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl
ARG TARGETARCH
RUN case "$TARGETARCH" in amd64) target=x86_64-unknown-linux-musl;; arm64) target=aarch64-unknown-linux-musl;; *) exit 1;; esac \
    && printf '%s' "$target" > /rust-target
WORKDIR /src
COPY agent/Cargo.toml agent/Cargo.lock ./
COPY agent/src ./src
RUN --mount=type=cache,id=blink-agent-registry-${TARGETARCH},sharing=locked,target=/usr/local/cargo/registry \
    --mount=type=cache,id=blink-agent-musl-${TARGETARCH},target=/src/target \
    cargo zigbuild --release --locked --target "$(cat /rust-target)" \
    && cp "target/$(cat /rust-target)/release/blink-agent" /blink-agent
COPY deploy/agent/blink-agent.service /package/blink-agent.service
COPY deploy/agent/root-terminal.conf.example deploy/agent/enable-root-terminal.sh /package/
COPY deploy/agent/update-agent.py deploy/agent/enable-auto-update.sh deploy/agent/blink-agent-update.service deploy/agent/blink-agent-update.timer /package/
COPY deploy/agent/proxy-manager.py deploy/agent/proxy-assets.json deploy/agent/enable-proxy.sh deploy/agent/blink-proxy-manager.service /package/
COPY deploy/agent/bootstrap.sh /install.sh.in
RUN mkdir -p /out && cp /blink-agent /package/blink-agent \
    && tar -czf /out/blink-agent-linux-${TARGETARCH}.tar.gz -C /package blink-agent blink-agent.service root-terminal.conf.example enable-root-terminal.sh update-agent.py enable-auto-update.sh blink-agent-update.service blink-agent-update.timer proxy-manager.py proxy-assets.json enable-proxy.sh blink-proxy-manager.service \
    && version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1) \
    && sed "s/@VERSION@/${version}/g" /install.sh.in > /out/install.sh
WORKDIR /out
RUN sha256sum blink-agent-linux-*.tar.gz > SHA256SUMS

FROM scratch AS artifacts
COPY --from=build /out/ /
