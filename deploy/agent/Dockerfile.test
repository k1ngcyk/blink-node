FROM debian:bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl python3 python3-yaml iputils-ping procps systemd openssl haproxy \
    && rm -rf /var/lib/apt/lists/*

FROM dependencies AS base
COPY web/public/downloads /releases/downloads

FROM base AS installer-test
COPY web/tests/installer.py /test.py
COPY deploy/agent/update-agent.py deploy/agent/test-updater.py /updater/
CMD ["python3", "/test.py"]

FROM base AS proxy-test
COPY deploy/agent/proxy-manager.py deploy/agent/proxy-assets.json deploy/agent/test-proxy.py /proxy/
CMD ["python3", "/proxy/test-proxy.py", "--integration"]

FROM alpine:3.23 AS alpine-installer-test
RUN apk add --no-cache bash curl ca-certificates python3 py3-yaml coreutils tar iproute2 openssl openrc busybox-openrc haproxy
COPY web/public/downloads /releases/downloads
COPY deploy/agent/test-alpine.py /test.py
COPY deploy/agent/test-proxy.py /test-proxy.py
CMD ["python3", "/test.py"]

FROM debian:bookworm-slim AS agent
COPY web/public/downloads /releases/downloads
ARG TARGETARCH
ARG AGENT_VERSION=0.1.0
RUN tar -xzf /releases/downloads/agent/v${AGENT_VERSION}/blink-agent-linux-${TARGETARCH}.tar.gz -C /usr/local/bin blink-agent \
    && useradd --uid 10001 --user-group --create-home --home-dir /var/lib/blink-agent --shell /bin/sh blink-agent
USER blink-agent
ENTRYPOINT ["blink-agent"]
